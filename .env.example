# =============================================================================
# Vindobona - Backend (vb-api) environment configuration
# =============================================================================
# Copy this file to ".env" and adjust the values for your environment.
# Variables without a leading "#" are required: the app refuses to start
# without them (fail-fast), or, for the S3 and SMTP blocks, fails on first
# use. Commented-out variables are optional; the value shown is the code's
# default or, where there is none, an example.
#
# The real environment file does NOT live in this repository. The target
# system provides it, and how depends on the deployment target. With the
# Podman/Quadlet setup it is "~/.env/vb-api.env", loaded by the unit
# "vb-api.container" through "EnvironmentFile=%h/.env/vb-api.env" (%h is the
# home directory of the service user).
# =============================================================================

# ===== Core / environment =====

# Controls environment-specific behavior (dev login, backup defaults).
# Allowed values: development, test, qa, production. Required, no default.
APP_ENVIRONMENT=development

# Comma-separated list of frontend origins allowed to access the API via CORS
# (browsers block every request from the Vue app otherwise). Each entry is
# scheme://host[:port] without wildcard, path or trailing slash. Required, no
# default; the app does not start if no valid entry remains.
CORS_ORIGINS=http://localhost:20001,http://127.0.0.1:20001

# Secret key that signs the JWT access tokens. At least 32 characters; the
# example value below is rejected on purpose, so replace it. Use a unique
# random value per environment. Required, no default.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Timezone for human-readable wall-clock output: the cron schedule of ALL
# scheduled jobs (see app/core/job_schedule_registry.py and app/worker.py),
# including db_backup and downsync (BACKUP_HOUR and the downsync hour that
# follows it are hours in this timezone), timestamps in e-mail subjects
# (app/core/mailer.py) and the timestamp in the file name of every database
# backup (app/services/backup_service.py). It does NOT affect database
# storage, which is always UTC (TIMESTAMPTZ).
# APP_TIMEZONE=Europe/Vienna

# ===== Database and job queue =====

# Connection string of the PostgreSQL database. The app uses the synchronous
# psycopg2 driver; an "+asyncpg" URL fails at start because that driver is not
# installed. Required, no default.
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/dbname

# Connection URL of the Valkey (Redis-compatible) server behind the ARQ job
# queue. Required, no default.
VALKEY_URL=redis://localhost:6379/0

# ===== Session / auth =====

# Validity of an access token, in minutes (1-1440).
SESSION_LIFETIME_MINUTES=15

# After this many minutes without activity the session counts as expired,
# even if the access token would still be valid (1-10080).
SESSION_IDLE_TIMEOUT_MINUTES=120

# Validity of a refresh token, in days (1-90). It lets a user obtain a new
# access token without logging in again.
REFRESH_TOKEN_LIFETIME_DAYS=7

# Minimum length for new or reset passwords (8-72; bcrypt reads at most 72
# bytes). Keep it equal to VITE_PASSWORD_MIN_LENGTH in the frontend: the two
# are not synchronised automatically.
PASSWORD_MIN_LENGTH=8

# ===== OAuth2 (Google) =====

# Client ID of the Google OAuth2 app behind "Sign in with Google". It must
# equal VITE_GOOGLE_CLIENT_ID in the frontend, since both refer to the same
# Google Cloud app. Optional: when unset the button disappears in the
# frontend, and the regular e-mail and password login is unaffected.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ===== SMTP / e-mail =====

# Host and port of the SMTP server for outgoing e-mail (password reset,
# birthday mails, reports). Required.
SMTP_HOST=localhost
SMTP_PORT=1025

# SMTP credentials. The literal string "null" means "no login needed", which
# suits local test servers such as Mailpit that run without authentication.
SMTP_USER=null
SMTP_PASSWORD=null

# Seconds to wait for the SMTP server (connect and each command) before the
# attempt fails (1-300). Optional.
# SMTP_TIMEOUT_SECONDS=30

# Sender address in the "From" header of all outgoing mail. Required.
SMTP_FROM_EMAIL=noreply@example.org

# Display name in the "From" header (optional, has a sensible default).
# SMTP_FROM_NAME=Vindobona

# Base URL of the frontend page that password-reset mails link to; the token is
# appended as a query parameter. Required.
FRONTEND_RESET_URL=http://localhost:20001/auth/reset-password

# ===== Payment page =====
# The payment page lists two accounts. The Altherrenschaft account and fee come
# from the database; the Aktivitas half comes from these four settings. They are
# required for the payment page and checked on first use, not at start, but a
# value that is set must be well formed (IBAN including its checksum, BIC).

# Name of the account holder and the fee wording shown for the Aktivitas.
AKTIVITAS_ACCOUNT_HOLDER=Verein Muster
AKTIVITAS_FEE_TEXT=Der Aktivenbeitrag beläuft sich auf EUR 30,- / Semester

# IBAN (spaces are allowed) and BIC of the Aktivitas account. The values below
# are a well-formed sample, not a real account.
AKTIVITAS_IBAN=AT61 1904 3002 3457 3201
AKTIVITAS_BIC=BKAUATWW

# ===== S3 / object storage =====
# Holds archive files, registry images and database backups. Compatible with
# AWS S3 and S3-compatible servers such as MinIO (local development).

# Endpoint URL of the S3 service. Leave it unset for AWS S3; point it to the
# local or internal URL for MinIO.
# S3_ENDPOINT_URL=http://localhost:9000

# Access credentials of the S3 service. Required as soon as S3 is actually
# used (uploads, downloads, backups); there is no meaningful default, so they
# are checked on first use, not at start. Never commit real keys.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Name of the bucket that holds all application data.
# S3_BUCKET=vindobona2-at

# Publicly reachable endpoint URL that is embedded in presigned URLs (direct
# download links for the frontend). Falls back to S3_ENDPOINT_URL; only needed
# when the internal and the public S3 host differ.
# S3_PUBLIC_ENDPOINT_URL=

# AWS region of the bucket (any pseudo-region works for MinIO).
# S3_REGION=us-east-1

# Validity of generated presigned URLs, in seconds (1-604800).
# S3_PRESIGNED_EXPIRY=900

# Path prefixes inside the bucket that separate the data areas. Change them
# only for a deliberately different bucket layout: existing data would
# otherwise sit under the wrong path.
# S3_PATH_STANDESDB_IMAGES=standesdb/images
# S3_PATH_STANDESDB_CACHE=standesdb/cache
# S3_PATH_ARCHIVE_STORE=archive/store
# S3_PATH_ARCHIVE_CACHE=archive/cache
# S3_PATH_DB_BACKUPS=db-backups
# S3_PATH_PUBLIC_GALLERY=public/gallery

# ===== Production bucket (downsync, non-production stages only) =====
# The nightly downsync job of a non-production stage mirrors the PRODUCTION
# bucket and restores its newest backup. These credentials belong to a
# dedicated, read-only user of the production bucket (s3:GetObject and
# s3:ListBucket) and are separate from the S3_* values above, which point to
# this stage's own storage. Leave them unset in production.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET=
# AWS_REGION=eu-central-1

# ===== Database backup schedule =====

# Switches the automatic, scheduled database backups (to S3) on or off.
# Usually false in development, test and QA to reduce noise.
# BACKUP_ENABLED=true

# Hour of day (0-23, in APP_TIMEZONE) at which the daily backup runs. The
# downsync job of the non-production stages runs one hour later.
# BACKUP_HOUR=3

# Number of days a database backup stays in S3 before it is deleted.
# BACKUP_RETENTION_DAYS=29

# ===== Tracking =====

# Number of months that request-tracking logs (the audit trail of API access)
# are kept before they are cleaned up.
# TRACKING_RETENTION_MONTHS=6

# ===== Administrators =====

# Comma-separated e-mail addresses whose member always holds the systemAdmin
# permission, independent of roles (break-glass access). An address counts
# only once its owner has verified it (completed a password reset) and is
# matched exactly (case-sensitive) against members.email, so keep the list very
# short and use the exact spelling stored for the member. Leave it unset to
# grant systemAdmin through the role only.
# SYSTEM_ADMIN_EMAILS=admin@example.org

# ===== Development only =====

# LOCAL DEVELOPMENT ONLY. Member UUID that is granted superuser rights on login
# to save clicking. Ignored outside APP_ENVIRONMENT=development, so it is
# harmless if set by accident in production; leave it unset in real
# environments anyway.
# DEV_SUPERUSER_ID=<uuid of a member in your local database>
